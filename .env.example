# Docker deployment settings (copy to .env; never commit .env)

# Image built locally from this source with ./docker-build.sh
ARTEX_IMAGE=artex-local
ARTEX_TAG=latest

POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Optional: fixed one-time token for the first-run /setup page.
# Leave empty to get a random token in `docker compose logs artex` and /app/setup.token.
ARTEX_SETUP_TOKEN=

# Optional: allowed cross-origin browser origins (comma separated). Leave empty in production.
ARTEX_CORS_ORIGINS=

# Upstream one-click update token. Leave EMPTY for this fork: the in-app updater
# downloads releases of the upstream repository and would replace this build.
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM (optional; normally configured in the UI under System -> LLM)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
