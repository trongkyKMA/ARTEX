# Docker deployment settings (copy to .env; never commit .env)

# Image built locally from this source with ./docker-build.sh
ARTEX_IMAGE=artex-local
ARTEX_TAG=latest

# Host address/ports for the UI+API and the (loopback-only) traffic recording proxy.
# ARTEX_BIND=127.0.0.1 keeps the UI reachable only from this host (put a reverse proxy in front).
ARTEX_BIND=0.0.0.0
ARTEX_HTTP_PORT=8787
ARTEX_PROXY_PORT=8788

POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Optional: fixed one-time token for the first-run /setup page.
# Leave empty to get a random token in `docker compose logs artex` and /app/keys/setup.token.
ARTEX_SETUP_TOKEN=

# Optional: allowed cross-origin browser origins (comma separated). Leave empty in production.
ARTEX_CORS_ORIGINS=

# In-app updater (System -> Settings -> Update) reads releases of this fork's private
# repository trongkyKMA/ARTEX. Fine-grained token for that repo only, with
# Contents: Read-only. Only binaries stamped with a release tag can self-update
# (images built by ./docker-build.sh are "dev"; with Docker prefer ./update.sh).
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM (optional; normally configured in the UI under System -> LLM)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
